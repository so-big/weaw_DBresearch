# Copy to backup.env on the server (chmod 600). Never commit backup.env.
#
# Where backups go. Assumed target: the college NAS (confirm with IT). Examples:
#   RESTIC_REPOSITORY=sftp:backup@nas.example.ac.th:/volume1/dbresearch
#   RESTIC_REPOSITORY=/mnt/nas/dbresearch          (an SMB/NFS mount on the server)
#   RESTIC_REPOSITORY=s3:https://s3.example.com/dbresearch
RESTIC_REPOSITORY=/path/to/restic/repo
# Restic's own password. Keep a copy OUTSIDE the server (like the KEK): lose it and every
# backup is unreadable.
RESTIC_PASSWORD_FILE=secrets/restic-password
# Optional: extra env for the repository backend (S3 keys etc.)
# RESTIC_ENV=secrets/restic-backend.env
