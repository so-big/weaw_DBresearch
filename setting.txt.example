# ======================================================================
# DBresearch Configuration File Template (setting.txt.example)
# คัดลอกไฟล์นี้เป็น 'setting.txt' เพื่อกำหนดค่าการทำงาน
# ======================================================================
# คำแนะนำการใช้งาน:
# 1. บรรทัดที่ขึ้นต้นด้วยเครื่องหมาย '#' หรือบรรทัดว่าง ระบบจะถือว่าเป็น Comment
# 2. การกำหนดค่าจัดแบ่งตามหมวดหมู่บริการ [web], [mysql]
# 3. กำหนดค่าในรูปแบบ: key = value
# ======================================================================

# ----------------------------------------------------------------------
# 1. บริการ: Web Application & API
# ----------------------------------------------------------------------
[web]
port = 8120
username = admin
password = admin123456

# ----------------------------------------------------------------------
# 2. บริการ: MySQL Database (dbroot / ฐานข้อมูลภายนอกสำหรับ OCR & ข้อมูล)
# ----------------------------------------------------------------------
[mysql]
host = 10.27.50.43
port = 3307
database = weaw_dbresearch
username = weaw_ocr
password = 
ssl_ca = mysql-ca.pem
