# Copy to .env on the server only (never commit .env).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Signs guest share-link grants. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Public access through the Cloudflare Tunnel (docs/OPERATIONS.md "Public demo").
# HTTPS-only session cookies (browsers still accept them on http://localhost for the SSH tunnel).
COOKIE_SECURE=true
# Visitor IP comes from Cloudflare (the port is bound to 127.0.0.1, so only the tunnel reaches it).
TRUSTED_IP_HEADER=CF-Connecting-IP

# Login providers, tried in order. Production: local (bootstrap admins) + the university API.
# AUTH_PROVIDERS=local,university
# UNIVERSITY_API_URL=https://...           # HTTPS only
# UNIVERSITY_API_KEY=                      # if the API wants one
# UNIVERSITY_ALLOWED_TYPES=teacher         # students are never let in
# UNIVERSITY_AUTO_CREATE=true              # false = ADMIN adds each teacher first
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_PER_USER=5
